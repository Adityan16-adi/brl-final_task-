# Set to 'api' to use real backend endpoints, or 'mock' for standalone preview mode
VITE_DATA_MODE=api
VITE_API_BASE_URL=http://localhost:5000/api

# FastAPI ML microservice endpoint (AI Mentor, Quiz generator, Spam filter)
VITE_ML_API_BASE_URL=http://localhost:8001

# MongoDB ObjectId values from your backend database (24-hex-character ObjectId)
VITE_DEMO_CLASS_ID=replace-with-class-document-id
VITE_DEMO_TEACHER_ID=replace-with-teacher-user-document-id
VITE_DEMO_STUDENT_ID=replace-with-student-user-document-id
