# Set to api to use the backend endpoints already implemented on apps/backend.
VITE_DATA_MODE=api
# Use a URL the browser can reach. In Codespaces, use the forwarded backend URL
# (for example, https://<backend-port>-<your-codespace>.<domain>/api), not localhost.
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Web app configuration. These public client values are not service-account secrets.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-classroom-cc0bc
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id

# Select a MongoDB Classroom ObjectId. Membership is checked by the server.
VITE_DEMO_CLASS_ID=6ad5a6a6fdc8ad6aaeccf18c
