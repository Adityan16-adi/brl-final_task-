# Flutter Build & Run Configuration Parameters (--dart-define)
#
# Default Host Behavior:
# - Web, Windows, macOS, Linux, and iOS Simulator automatically connect to http://localhost:8001 (ML) and http://localhost:5000 (Backend).
# - Android Emulator automatically connects to http://10.0.2.2:8001 (ML) and http://10.0.2.2:5000 (Backend).
#
# Custom Deployment / Physical Device Overrides:
ML_API_BASE_URL=http://localhost:8001
CORE_API_BASE_URL=http://localhost:5000
LEARNING_API_BASE_URL=http://localhost:5000

# Firebase Client Configuration (Optional - without these, development demo mode is active with student@demo.com and teacher@demo.com)
FIREBASE_API_KEY=your_firebase_web_or_client_api_key
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id

# Example flutter command with definitions:
# flutter run -d chrome --dart-define=ML_API_BASE_URL=http://localhost:8001
